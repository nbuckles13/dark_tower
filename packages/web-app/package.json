{
  "name": "@darktower/web-app",
  "version": "0.0.0",
  "private": true,
  "description": "Dark Tower minimal browser demo: sign-up / sign-in / create-meeting / meeting-join, wired to the SDK.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest run --config vitest.node.config.ts",
    "test:component": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "svelte-check --tsconfig ./tsconfig.json && eslint src/ && prettier --check \"src/**/*.{ts,svelte}\"",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@darktower/sdk-core": "workspace:*",
    "@darktower/sdk-svelte": "workspace:*",
    "svelte": "5.56.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "22.10.5",
    "@vitest/browser": "4.1.8",
    "@vitest/browser-playwright": "4.1.8",
    "playwright": "1.55.1",
    "svelte-check": "^4.6.0",
    "typescript": "5.7.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^1.1.0"
  }
}
