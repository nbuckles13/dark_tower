{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No `outDir` here: this config is typecheck-only (`noEmit`). Setting it
    // makes TS 6 infer a `rootDir` of this package dir, which then rejects the
    // cross-package sources the `paths` aliases below deliberately pull in
    // (TS6059). The real emit is tsconfig.build.json, which sets both itself.
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      // TEST-ONLY type resolution: point the test-utils dependency at its TS
      // source so `tsc --noEmit` (lint) resolves `MockWebTransport`'s types
      // without a built `dist/`. The production build uses tsconfig.build.json,
      // which EXCLUDES tests and emits no edge to test-utils (R-13 Pattern A).
      "@darktower/test-utils": ["../test-utils/src/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "vite.config.ts", "vitest.config.ts", "vitest.component.config.ts"],
  "exclude": ["dist", "node_modules"]
}
