{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "sdk-core",
  "projectType": "library",
  "sourceRoot": "packages/sdk-core/src",
  "implicitDependencies": ["proto-gen"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["proto-gen"], "target": "codegen" }],
      "options": {
        "cwd": "packages/sdk-core",
        "command": "vite build"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["proto-gen"], "target": "codegen" }],
      "options": {
        "cwd": "packages/sdk-core",
        "command": "vitest run --coverage"
      }
    },
    "test:component": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["proto-gen"], "target": "codegen" }],
      "options": {
        "cwd": "packages/sdk-core",
        "command": "vitest run --config vitest.component.config.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["proto-gen"], "target": "codegen" }],
      "options": {
        "cwd": "packages/sdk-core",
        "command": "tsc --noEmit && eslint src/ && prettier --check \"src/**/*.ts\""
      }
    }
  }
}
