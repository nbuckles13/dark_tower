{
  "name": "@darktower/sdk-core",
  "version": "0.0.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "description": "Dark Tower browser SDK core: WebTransport transport abstraction and length-prefix wire framing.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "vite build",
    "test:unit": "vitest run --coverage",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0"
  },
  "devDependencies": {
    "@darktower/test-utils": "workspace:*",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "5.0.5",
    "msw": "3.0.3",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
