{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No `outDir` here: this config is typecheck-only (`noEmit`). Setting it
    // makes TS 6 infer a `rootDir` of this package dir, which then rejects the
    // cross-package sources the `paths` aliases below deliberately pull in
    // (TS6059). The real emit is tsconfig.build.json, which sets both itself.
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      // Resolve the sdk-core dependency to its TS source so svelte-check / dts
      // resolve `@darktower/sdk-core` types without first building sdk-core's
      // `dist/`. `paths` affects resolution only — emitted `.d.ts` still import
      // from the bare `@darktower/sdk-core` specifier (the closed public barrel).
      "@darktower/sdk-core": ["../sdk-core/src/index.ts"]
    }
  },
  "include": ["src/**/*", "src/**/*.svelte", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
