{
  "name": "@darktower/sdk-svelte",
  "version": "0.0.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "description": "Dark Tower Svelte 5 adapter: rune stores wrapping the sdk-core MeetingSession events.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "vite build",
    "test:component": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "svelte-check --tsconfig ./tsconfig.json && eslint src/",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@darktower/sdk-core": "workspace:*"
  },
  "devDependencies": {
    "@opentelemetry/api": "catalog:",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "25.9.9",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "svelte": "5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  }
}
