{
  "name": "@darktower/sdk-svelte",
  "version": "0.0.0",
  "private": true,
  "description": "Dark Tower Svelte 5 adapter: rune stores wrapping the sdk-core MeetingSession events.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "vite build",
    "test:component": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "svelte-check --tsconfig ./tsconfig.json && eslint src/ && prettier --check \"src/**/*.{ts,svelte}\"",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@darktower/sdk-core": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "22.10.5",
    "@vitest/browser": "4.1.8",
    "@vitest/browser-playwright": "4.1.8",
    "playwright": "1.55.1",
    "svelte": "5.56.4",
    "svelte-check": "^4.6.0",
    "typescript": "5.7.3",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^1.1.0"
  }
}
