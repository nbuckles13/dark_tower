{
  "name": "@darktower/test-utils",
  "version": "0.0.0",
  "private": true,
  "description": "Dark Tower test doubles, mocks, and assertion stubs (test-only).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./test-only/signer": {
      "types": "./dist/test-only/signer.d.ts",
      "import": "./dist/test-only/signer.mjs",
      "require": "./dist/test-only/signer.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "vite build",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && eslint src/ && prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@noble/ed25519": "3.1.0",
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
