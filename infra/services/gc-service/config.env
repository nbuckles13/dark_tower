# HTTP API bind address
BIND_ADDRESS=0.0.0.0:8080
# gRPC server for MC registration
GC_GRPC_BIND_ADDRESS=0.0.0.0:50051
# Deployment region (local for Kind)
GC_REGION=local
# AC service discovery via Kubernetes DNS
AC_JWKS_URL=http://ac-service.dark-tower:8082/.well-known/jwks.json
AC_INTERNAL_URL=http://ac-service.dark-tower:8082
# ---- Required behaviour keys (2026-11-15 meeting-end-safety) ----
# Every key in this block is REQUIRED (no compiled-in default): a missing or
# invalid value fails GC startup with a ConfigError naming the key.
#
# JWT clock-skew tolerance for token validation, seconds; range [1, 600].
JWT_CLOCK_SKEW_SECONDS=300
# Per-client HTTP API rate limit, requests per minute; > 0.
RATE_LIMIT_RPM=100
# MC liveness threshold, seconds; must exceed the 10 s MC fast-heartbeat
# interval GC pushes on registration. THE one definition of "this MC is
# alive": the health checker marks MCs stale with it, and join reuse, join
# failover and the assignment-cleanup backstop all key on it (ADR-0010 §3).
# An MC whose heartbeat is younger keeps its meetings whatever its status.
MC_STALENESS_THRESHOLD_SECONDS=30
# Accept->commit budget, ms: how long after GC sends AssignMeetingWithMh the
# assignment row may still commit; past it no row is written and the next MC
# is tried. Range [1, MIN_MEETING_JOIN_WINDOW / 2] = [1, 2500]
# (crates/common/src/meeting_lifecycle.rs carries the margin rationale).
GC_ASSIGN_COMMIT_BUDGET_MS=2000
# Assignment cleanup job (ADR-0010 §3 item 3). Interval >= 1 s; the backstop
# ends a row only when its MC is no longer alive AND the row is older than
# GC_INACTIVITY_HOURS (>= 1); ended rows are hard-deleted after
# GC_RETENTION_DAYS (>= 1).
GC_CLEANUP_INTERVAL_SECONDS=3600
GC_INACTIVITY_HOURS=1
GC_RETENTION_DAYS=7
# Graceful-shutdown drain after SIGTERM, seconds; range [0, 30] (0 skips it).
# Must stay below deployment.yaml terminationGracePeriodSeconds (35) with room
# to exit; gc-test-utils asserts the shipped pair.
GC_DRAIN_SECONDS=30
# In-cluster OTel collector endpoint for the /api/v1/telemetry proxy (R-2/R-59).
# BARE BASE (scheme + host + port, NO /v1/... path): the telemetry forwarder
# appends /v1/metrics or /v1/traces itself (telemetry_forwarder.rs:3-5,33-37).
# A value WITH /v1/... would double-append (/v1/metrics/v1/metrics) → 404.
# REQUIRED. An explicitly EMPTY value disables the proxy (the route returns 503).
OTEL_COLLECTOR_ENDPOINT=http://otel-collector.dark-tower:4318
# Telemetry proxy size cap (bytes) and per-user rate limit (requests/minute,
# per-pod, in-memory GCRA). REQUIRED, > 0.
# crates/env-tests/tests/31_gc_telemetry.rs reads the DEPLOYED values of both
# from the live ConfigMap generation (the 413 oversize case + the 429 case).
TELEMETRY_PROXY_MAX_BYTES=262144
TELEMETRY_PROXY_RATE_LIMIT_PER_MINUTE=60
# ---- OpenTelemetry (R-55, task #26) ----
# GC's OTel SDK is wired into main.rs via init_otel (R-55), gated by an
# explicit boolean OTEL_ENABLED (NOT presence of OTLP_ENDPOINT). This is the
# prod base, so OTEL_ENABLED defaults to "false" here; the Kind overlay
# patches it to "true" for dev. Enabling requires OTEL_ENABLED=true PLUS the
# GC->collector egress NetworkPolicy rule on :4317 (now present, distinct
# from the existing :4318 telemetry-proxy rule above) PLUS a reachable
# collector — init_otel probes eagerly and FAILS HARD at startup if the
# collector is unreachable (pod fails readiness; mirrors AC's task #25
# exemplar).
OTEL_ENABLED=false
# OTLP-gRPC endpoint for the in-cluster OTel collector (R-59) — GC's OWN
# span-export endpoint, distinct from OTEL_COLLECTOR_ENDPOINT above (which
# is the :4318 OTLP-HTTP endpoint the /api/v1/telemetry proxy forwards to).
# The http:// scheme is required (parsed via tonic Endpoint::from_shared —
# a bare host:port fails at init). Only consumed when OTEL_ENABLED=true.
OTLP_ENDPOINT=http://otel-collector.dark-tower:4317
# Head-sampling ratio in [0.0, 1.0]; REQUIRED; init_otel is the authoritative
# validator.
OTEL_SAMPLE_RATE=1.0
# deployment.environment resource attribute (ADR-0011); REQUIRED. NOTE: this prod base
# hardcodes "development"; prod OTel graduation MUST overlay-patch this so
# prod telemetry is not mistagged (same tracked caveat as AC's task #25 —
# see docs/TODO.md).
DEPLOYMENT_ENVIRONMENT=development
# ---- CORS (R-1/R-3, task #5) ----
# Browser-SDK CORS allowlist for GC's /api/v1/* HTTP API. Comma-separated
# explicit origins; the router's CorsLayer NEVER uses `*`. This prod base is
# EMPTY = fail-closed (no origin allowed, no Access-Control-Allow-Origin ever
# emitted); the Kind overlay patches it to "http://localhost:5173" for the
# Vite demo. Mirrors the OTEL_ENABLED base-false / overlay-true precedent above.
CORS_ALLOWED_ORIGINS=
# ---- MH registry freshness and sizing (ADR-0039 §3, §10; R-23, R-24/R-26) ----
# All five are REQUIRED (no compiled-in default): a missing or out-of-range
# value fails GC startup with a ConfigError naming the key. This file is the
# single source of the reference values; gc-test-utils reads them from here.
#
# Load-report interval pushed to every MH in RegisterMHResponse; range
# [1000, 60000] ms. The MH staleness bound B = GC_MH_STALENESS_MULTIPLIER x
# this value is the ONE freshness bound GC uses for MH (selection, stale sweep,
# gc_mh_available), published as gc_mh_staleness_threshold_seconds.
# WARNING: an MH adopts the interval only when it first registers (it builds
# its report ticker once), while a new B applies fleet-wide as soon as GC
# rolls. Every MH's live cadence must stay well below every GC replica's B.
# Lowering this (or lowering the multiplier) so that B_new <= an MH's current
# cadence makes healthy MHs flap unhealthy. Procedure:
# docs/runbooks/gc-deployment.md, Configuration Reference.
GC_MH_LOAD_REPORT_INTERVAL_MS=10000
# Staleness multiplier k; range [2, 10].
GC_MH_STALENESS_MULTIPLIER=3
# Registry retention: rows with no load report for this long are deleted.
# Must exceed B (compared in ms); at most 2592000 (30 d).
GC_MH_REGISTRY_RETENTION_SECONDS=3600
# MHs selected for a NEW meeting; range [1, 4]. Existing meetings unaffected.
GC_MH_INITIAL_HANDLERS_PER_MEETING=2
# Cap on AcquireMediaHandlerRequest.exclude_handler_ids (ADR-0039 §3); range
# [4, 64] and must exceed GC_MH_INITIAL_HANDLERS_PER_MEETING. Pushed to MC in
# RegisterMCResponse.max_exclude_handler_ids and enforced by AcquireMediaHandler.
# MC derives its per-meeting attempt bound as cap - current set size; removed
# handlers stay excluded for the meeting's life. A change reaches an MC only
# when it re-registers. Procedure: docs/runbooks/gc-deployment.md,
# Configuration Reference.
GC_MH_MAX_EXCLUDE_HANDLER_IDS=16
# ---- RegisterMH endpoint allowlists (ADR-0039 §7, R-25: arm 0 of the rule
# stated above RegisterMHRequest in proto/dark_tower/internal/v1/internal.proto) ----
# All five are REQUIRED (no compiled-in default). A missing, EMPTY or malformed
# value fails GC startup with a ConfigError naming the key: an empty allowlist
# would reject every MH while GC reports healthy, so it fails loudly instead.
# Lists are comma-separated.
#
# The four TOPOLOGY keys below are deliberately EMPTY in this base: every
# deploy path renders them. Kind (host-mode and devloop):
# infra/kind/scripts/deploy.sh:render_env_overlay (gc_mh_allowlist_literals),
# derived from the MH hostPort slot table, the kind-config podSubnet and the MH
# template's MH_GRPC_ADVERTISE_ADDRESS. Never hand-edit Kind values here; change
# the kind-config / helper port table and redeploy. A converge that skips the
# render leaves GC crash-looping with the key named (old pods keep serving).
#
# Client-facing (webtransport_endpoint; scheme is https, fixed in code):
# exact hosts (DNS name or IP literal) or ".suffix" entries (label boundary,
# never the apex, never an IP host).
GC_MH_WT_ALLOWED_HOSTS=
# Client-facing ports.
GC_MH_WT_ALLOWED_PORTS=
# Internal (grpc_endpoint) schemes. `grpc` = CLEARTEXT h2c, UNAUTHENTICATED: no
# TLS and no peer authentication of the MH server, so MC's bearer crosses that
# channel in cleartext (S6, docs/TODO.md §Media Path Obligations). The allowlist
# bounds where MC sends its credential; it is NOT peer authentication and does
# not close S6. Flips by config only to a TLS scheme when S6 mTLS lands
# (spelling decided then). A policy value, not topology, so it lives here.
GC_MH_GRPC_ALLOWED_SCHEMES=grpc
# Internal hosts: IP literals inside these CIDRs (hostnames are rejected).
# Kind renders the WHOLE pod subnet, so there this bounds the address space
# only, not MH-pod identity; in-cluster, MC's egress NetworkPolicy (50053 only
# to app=mh-service) keeps MC's bearer on MH pods. Elsewhere set the narrowest
# CIDR(s) containing only MH pods.
GC_MH_GRPC_ALLOWED_CIDRS=
# Internal ports.
GC_MH_GRPC_ALLOWED_PORTS=
