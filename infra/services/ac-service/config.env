AC_CLUSTER_NAME=dark-tower-prod
# Rate limit settings relaxed for Kind dev/test environments
AC_RATE_LIMIT_WINDOW_MINUTES=1
AC_RATE_LIMIT_MAX_ATTEMPTS=100
AC_REGISTRATION_RATE_LIMIT_WINDOW_MINUTES=1
AC_REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=100
# ---- OpenTelemetry (R-55) ----
# AC's OTel SDK is wired into main.rs via init_otel (R-55), gated by an
# explicit boolean OTEL_ENABLED (NOT presence of OTLP_ENDPOINT). This is the
# prod base (AC_CLUSTER_NAME: dark-tower-prod above), so OTEL_ENABLED defaults
# to "false" here; the Kind overlay patches it to "true" for dev. Enabling
# requires OTEL_ENABLED=true PLUS the AC->collector egress NetworkPolicy rule
# (now present) PLUS a reachable collector — init_otel probes eagerly and
# FAILS HARD at startup if the collector is unreachable (pod fails readiness).
OTEL_ENABLED=false
# OTLP-gRPC endpoint for the in-cluster OTel collector (R-59). The http://
# scheme is required (parsed via tonic Endpoint::from_shared — a bare
# host:port fails at init). Only consumed when OTEL_ENABLED=true.
OTLP_ENDPOINT=http://otel-collector.dark-tower:4317
# Head-sampling ratio in [0.0, 1.0]; init_otel is the authoritative validator.
OTEL_SAMPLE_RATE=1.0
# deployment.environment resource attribute (ADR-0011). NOTE: this prod base
# hardcodes "development"; prod OTel graduation MUST overlay-patch this so prod
# telemetry is not mistagged (tracked in docs/TODO.md).
DEPLOYMENT_ENVIRONMENT=development
# ---- Required behaviour/topology keys (meeting-end safety P2, 2026-11-15) ----
# Each was a silent Rust default; AC now refuses boot without it. The values
# are the ones AC already ran, so nothing changes at deploy.
# BIND_ADDRESS — AC's HTTP listener. Enforced by: ac-service, at startup
# (missing refuses boot); read by statefulset.yaml via a HARD ref.
BIND_ADDRESS=0.0.0.0:8082
# JWT_CLOCK_SKEW_SECONDS — tolerance on token iat/exp checks (NIST SP 800-63B
# recommends 300). Bounds (0, 600]; below 60 is accepted with a WARN.
# Enforced by: ac-service, at startup (missing, out of bounds or unparseable
# refuses boot); read by statefulset.yaml via a HARD ref. Where an operator
# sees it: AC's "Configuration loaded successfully" line.
JWT_CLOCK_SKEW_SECONDS=300
# BCRYPT_COST — client-secret / password hash cost (ADR-0003: 12). Bounds
# [10, 14]; below 12 is accepted with a WARN. Changing it affects NEW hashes
# only. Enforced by: ac-service, at startup (missing, out of bounds or
# unparseable refuses boot); read by statefulset.yaml via a HARD ref.
BCRYPT_COST=12
# AC_DRAIN_SECONDS — seconds AC keeps serving in-flight requests after SIGTERM.
# Bounds [0, 30] (inside the statefulset's terminationGracePeriodSeconds, 35).
# Enforced by: ac-service, at startup (missing, unparseable or out of bounds
# refuses boot — an unparseable value used to be masked as 30); read by
# statefulset.yaml via a HARD ref. Local runs (iterate.sh) override it to 0.
AC_DRAIN_SECONDS=30
