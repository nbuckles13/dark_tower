      "description": "GC heartbeat RPC p95 latency. SLO target < 100ms (mh-service metrics catalog). Green < 50ms, Yellow 50-100ms, Red >= 100ms. Red boundary matches the MHGCHeartbeatLatencyHigh info alert (p95 > 0.100s).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "9.5.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(mh_gc_heartbeat_latency_seconds_bucket{job=\"mh-service\"}[5m])))",
          "legendFormat": "Current p95",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GC Heartbeat SLO - p95 Latency (< 100ms)",
      "type": "gauge"
