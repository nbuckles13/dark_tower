      "pluginVersion": "9.5.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "100 * (sum(rate(mh_gc_heartbeats_total{job=\"mh-service\", status=\"success\"}[5m])) / sum(rate(mh_gc_heartbeats_total{job=\"mh-service\"}[5m])))",
          "legendFormat": "Heartbeat Success Rate",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GC Heartbeat SLO - Success Rate",
      "type": "gauge"
    },
