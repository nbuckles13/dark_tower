# engine-strict: fail `pnpm install` LOUDLY when the running Node/pnpm does not
# satisfy the root package.json `engines` range, instead of silently skipping
# engines-mismatched optional native bindings (e.g. @rolldown/binding-linux-x64-gnu).
# Root `engines.node` is the SSoT this keys off — it is tightened to the true
# workspace floor so a below-floor Node fails here rather than at vite launch with
# "cannot find native binding". Incident: 2026-08-05 host dev-env failure; see
# docs/runbooks/client-dev-local.md F11.
engine-strict=true

# strict-dep-builds: pnpm 10 runs no dependency install script unless approved. Every
# dependency that ships one must be classified in package.json — pnpm.onlyBuiltDependencies
# (run it) or pnpm.ignoredBuiltDependencies (skip it) — or `pnpm install` FAILS, instead of
# listing it in a warning nobody reads. Ignored, verified no-ops here (2026-09-30):
#   @bufbuild/buf — install.js re-checks the platform binary, which arrives as an optional
#                   dependency (it downloads one only if optional deps were dropped)
#   msw           — copies mockServiceWorker.js only when msw.workerDirectory is set; msw is
#                   used as a Node test server (setupServer) only
#   nx            — asserts platform support and updates the Nx Cloud client; no Nx Cloud
# A checkout installed before this setting keeps pnpm's cached ignore list and fails once
# with ERR_PNPM_IGNORED_BUILDS: remove node_modules and reinstall (--force is not enough).
strict-dep-builds=true
