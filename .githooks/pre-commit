#!/bin/bash
#
# Pre-commit hook for Dark Tower project
# Automatically runs cargo fmt and cargo clippy before each commit
#

set -e

echo "🔍 Running pre-commit checks..."

# Check code formatting (does NOT format, only checks).
#
# ADR-0037 §D7: this is a tree-attesting gate, so it stays CHECK-ONLY — auto-formatting here would
# mutate the tree being attested. It is NOT routed through fmt_mode() in scripts/lang/rust/fmt.sh
# because this hook is deliberately `#!/bin/bash` + bash-3.2-tolerant (see _gate2_binding.sh:16-43) and
# must not source _common.sh (bash-4 tripwire + lastpipe/job-control toggles on EVERY commit). The lane
# here is a COMPILE-TIME CONSTANT (always check), not a runtime decision, so there is nothing for the
# helper to decide. Drift is prevented by the fmt-lane policy guard (asserts this invocation stays the
# check-only form), not by sharing the helper. Keep this in sync with scripts/lang/rust/fmt.sh's CHECK
# branch (`cargo fmt --all -- --check`).
echo "  ➜ Checking code formatting with cargo fmt..."
# `if !` not `cmd; if [ $? ]` — under `set -e` the bare command would abort the hook before the test
# (the old form's error message never printed).
if ! cargo fmt --all -- --check; then
    echo ""
    echo "❌ Code formatting issues detected!"
    echo "   Run 'cargo fmt' to fix formatting, then commit again."
    exit 1
fi

# Run cargo clippy on changed Rust files
echo "  ➜ Running clippy on changed files..."
if git diff --cached --name-only | grep -q "\.rs$"; then
    cargo clippy --all-targets --all-features -- -D warnings
    if [ $? -ne 0 ]; then
        echo ""
        echo "❌ Clippy warnings/errors detected!"
        echo "   Fix the issues and commit again."
        exit 1
    fi
fi

# Check devloop main.md files for unfilled sections
DEVLOOP_ERRORS=""
for f in $(git diff --cached --name-only | grep 'docs/devloop-outputs/.*/main\.md$' | grep -v '_template/'); do
    # Check for TBD placeholders (unfilled sections)
    tbds=$(git show ":$f" | grep -n '^TBD$' || true)
    if [ -n "$tbds" ]; then
        DEVLOOP_ERRORS="${DEVLOOP_ERRORS}  $f: has unfilled TBD sections\n"
    fi
    # Check for pending reviewers in Loop State table
    pending=$(git show ":$f" | grep -P '\|\s*`?pending`?\s*\|' || true)
    if [ -n "$pending" ]; then
        DEVLOOP_ERRORS="${DEVLOOP_ERRORS}  $f: has pending reviewers in Loop State\n"
    fi
done
if [ -n "$DEVLOOP_ERRORS" ]; then
    echo ""
    echo "❌ Devloop output main.md incomplete:"
    echo -e "$DEVLOOP_ERRORS"
    echo "   Fill in all TBD sections and reviewer names before committing."
    exit 1
fi

# TODO-tracking format guard at commit time (task #19 incident, 2026-08-05):
# devloop Step 9 writes main.md §Accepted Deferrals and TODO.md entries AFTER
# Gate 2 validation ran, so the in-devloop pipeline structurally cannot see
# them — the commit is the boundary where that content becomes durable, so
# the format contract is enforced here. (Checks the working tree, not staged
# content — same semantics as the pipeline's own guard run. Backstop: the
# run-story independent gate re-runs all guards post-devloop.)
if git diff --cached --name-only | grep -qE 'docs/devloop-outputs/.*/main\.md$|(^|/)TODO\.md$'; then
    echo "  ➜ Checking TODO-tracking format (dt-guard todo-tracking)..."
    __dtg_root="$(git rev-parse --show-toplevel)"
    __dtg_bin="${__dtg_root}/target/release/dt-guard"
    if [ ! -x "$__dtg_bin" ]; then
        echo "     (dt-guard not built — building)"
        (cd "$__dtg_root" && cargo build --release -q -p dt-guard) || {
            echo "❌ dt-guard build failed; cannot run todo-tracking guard."
            exit 1
        }
    fi
    "$__dtg_bin" todo-tracking --root "$__dtg_root" || {
        echo ""
        echo "❌ TODO-tracking violation (see above)."
        echo "   §Accepted Deferrals must be pointer bullets to docs/TODO.md — body text lives in TODO.md."
        exit 1
    }
fi

# Gate-2 authority gate (task #51). For a devloop-completion commit (a staged
# main.md at Phase=complete WITH validated files staged), require a fresh,
# tree-matching, PASSing pipeline verdict produced by scripts/layer-all.sh — so a
# pipeline run cannot be asserted in lieu of actually running (skip-vector C).
#
# All logic lives in the shared library function gate2_validate_commit (single
# source with the producer, so the binding can't diverge). It is FAIL-CLOSED: any
# error, or an absent/FAIL/stale/slug-mismatched verdict for a triggering commit,
# blocks here; for non-devloop commits it no-ops.
#
# LOCAL-ONLY / ADVISORY: this hook is anti-drift, NOT a security boundary —
# `git commit --no-verify` bypasses it entirely, and an agent with filesystem
# write can hand-author a PASS verdict. CI's independent from-scratch re-run of
# layer-all.sh is the only non-bypassable enforcement point
# (see docs/runbooks/devloop-validation.md).
echo "  ➜ Checking Gate-2 validation verdict (devloop commits)..."
__gate2_repo_root="$(git rev-parse --show-toplevel)"
__gate2_lib="${__gate2_repo_root}/scripts/lang/_gate2_binding.sh"
if [ ! -f "$__gate2_lib" ]; then
    # The library is itself a tracked, validated file; its absence means a broken
    # checkout. Fail closed rather than silently skipping the authority gate.
    echo ""
    echo "❌ Gate-2: shared library missing at $__gate2_lib"
    echo "   Cannot evaluate the validation verdict. Restore the file, or use 'git commit --no-verify' if intentional."
    exit 1
fi
# shellcheck source=../scripts/lang/_gate2_binding.sh
source "$__gate2_lib"
gate2_validate_commit || exit 1

echo "✅ All pre-commit checks passed!"
exit 0
