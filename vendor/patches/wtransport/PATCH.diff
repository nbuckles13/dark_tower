+/// PATCH(dark-tower ADR-0039 §7): why this side's WebTransport session close could not be sent.
+#[derive(thiserror::Error, Debug, Clone, Eq, PartialEq)]
+pub enum SessionCloseError {
+    /// A session close was already started on this connection.
+    #[error("a session close was already started")]
+    AlreadyClosing,
+    /// The connection's driver task is gone.
+    #[error("the connection driver is gone")]
+    DriverGone,
+    /// The CONNECT stream was already reset, finished or never established.
+    #[error("no CONNECT stream to close")]
+    NoConnectStream,
+    /// Writing the capsule failed.
+    #[error("writing the session-close capsule failed: {0}")]
+    Write(StreamWriteError),
+}
