+/// PATCH(dark-tower ADR-0039 §7): the EXACT bytes written on the CONNECT stream to close a session
+/// with `code`: one HTTP/3 DATA frame carrying one CLOSE_WEBTRANSPORT_SESSION
+/// capsule (type 0x2843, length 4, `code` as u32 big-endian, empty message).
+/// Varints are minimal (RFC 9000 §16), via wtransport-proto's own writer.
+#[doc(hidden)]
+pub fn encode_close_session_capsule(code: u32) -> Vec<u8> {
+    use wtransport_proto::bytes::BytesWriter;
+    use wtransport_proto::frame::Frame;
+
+    // Upstream's `CAPSULE_TYPE_CLOSE_WEBTRANSPORT_SESSION` is private; this
+    // copy is tied to it by the encode-then-parse test in the consumer.
+    const CLOSE_WEBTRANSPORT_SESSION: VarInt = VarInt::from_u32(0x2843);
+    const CODE_LEN: u32 = 4;
+
+    let mut capsule = Vec::with_capacity(8);
+    capsule
+        .put_varint(CLOSE_WEBTRANSPORT_SESSION)
+        .expect("Vec writer is unbounded");
+    capsule
+        .put_varint(VarInt::from_u32(CODE_LEN))
+        .expect("Vec writer is unbounded");
+    capsule
+        .put_bytes(&code.to_be_bytes())
+        .expect("Vec writer is unbounded");
+
+    let mut bytes = Vec::with_capacity(capsule.len() + 2);
+    Frame::new_data(std::borrow::Cow::Owned(capsule))
+        .write(&mut bytes)
+        .expect("Vec writer is unbounded");
+    bytes
+}
