# Dark Tower - Local Development Environment Variables
# Copy this file to .env and fill in the values
# WARNING: .env is git-ignored and contains secrets - NEVER commit it

# ========================================
# Database
# ========================================
DATABASE_URL=postgresql://darktower:dev_password_change_in_production@localhost:5432/dark_tower

# ========================================
# Redis
# ========================================
REDIS_URL=redis://:dev_password_change_in_production@localhost:6379

# ========================================
# Auth Controller
# ========================================

# Master encryption key for AES-256-GCM (REQUIRED for Auth Controller)
# Generate with: ./scripts/generate-master-key.sh
# WARNING: This is security-critical - never commit, log, or expose in APIs
AC_MASTER_KEY=REPLACE_WITH_GENERATED_KEY

# Auth Controller URL (for services to connect)
AC_URL=http://localhost:8082

# TLS certificates for local development
# Generate with: ./scripts/generate-dev-certs.sh
TLS_CERT_PATH=infra/docker/certs/auth-localhost.crt
TLS_KEY_PATH=infra/docker/certs/auth-localhost.key

# ========================================
# Service Credentials (OAuth 2.0 Client Credentials)
# ========================================
# These are generated by registering each service with Auth Controller
# Register with: ./scripts/register-service.sh <service-type> <region>

# Global Controller
GC_AC_CLIENT_ID=
GC_AC_CLIENT_SECRET=

# Meeting Controller
MC_AC_CLIENT_ID=
MC_AC_CLIENT_SECRET=

# Media Handler
MH_AC_CLIENT_ID=
MH_AC_CLIENT_SECRET=

# ========================================
# Logging
# ========================================
RUST_LOG=info

# Service-specific logging (uncomment to enable debug logging)
# RUST_LOG=info,ac_service=debug
# RUST_LOG=info,global_controller=debug
# RUST_LOG=info,meeting_controller=debug
# RUST_LOG=info,media_handler=debug

# ========================================
# Observability
# ========================================

# OpenTelemetry (Jaeger)
OTLP_ENDPOINT=http://localhost:4317

# ========================================
# Service Bind Addresses
# ========================================

# Auth Controller
AC_BIND_ADDRESS=0.0.0.0:8082

# Global Controller
GC_BIND_ADDRESS=0.0.0.0:8081

# Meeting Controller (QUIC/WebTransport)
# MC reads MC_WEBTRANSPORT_BIND_ADDRESS. The former MC_BIND_ADDRESS here had no reader anywhere.
MC_WEBTRANSPORT_BIND_ADDRESS=0.0.0.0:4433
# MC media signalling and the story-3 per-kind receive-slot caps.
# ANCHOR (DRY): values mirror infra/services/mc-service/config.env, their
# single home. The full MC local-run set, required keys included, is the MC
# block in docs/DEVELOPMENT.md.
MC_MAX_RECEIVE_CAPABILITY_DECLARATIONS=64
MC_KEK_ROTATION_DEBOUNCE_SECONDS=60
MC_MEDIA_CONNECT_SETTLE_MS=1500
MC_MAX_AUDIO_RECEIVE_SLOTS=8
# 0 is the video-off lever.
MC_MAX_VIDEO_RECEIVE_SLOTS=4
# RETIRED — still required by the current MC image; removed with MC-A.
MC_MAX_RECEIVE_SLOTS=8
MC_AUDIO_CODEC=opus
MC_AUDIO_MAX_BITRATE_BPS=48000
MC_AUDIO_FRAME_RATE_HZ=50

# Shared media codec profile (story 3), read by MC (all nine) and MH (the
# bitrate, frame-rate and min-keyframe-interval keys).
# ANCHOR (DRY): values mirror infra/services/media-codec-profile/profile.env,
# their single home — if they disagree, it wins.
MEDIA_VIDEO_CODEC=vp8
MEDIA_VIDEO_WIDTH=640
MEDIA_VIDEO_HEIGHT=360
MEDIA_VIDEO_FRAME_RATE_HZ=30
MEDIA_VIDEO_MAX_BITRATE_BPS=800000
MEDIA_VIDEO_MIN_KEYFRAME_INTERVAL_MS=500
MEDIA_AUDIO_CODEC=opus
MEDIA_AUDIO_MAX_BITRATE_BPS=48000
MEDIA_AUDIO_FRAME_RATE_HZ=50

# Media Handler (QUIC)
# MH reads MH_WEBTRANSPORT_BIND_ADDRESS. The former MH_BIND_ADDRESS here had no reader anywhere.
MH_WEBTRANSPORT_BIND_ADDRESS=0.0.0.0:4434
# Egress-budget chain, ADR-0036 §8 policy bounds, and the story-3 stream and
# keyframe keys.
# ANCHOR (DRY): values mirror infra/services/mh-service/config.env, which is
# their single home (the budget mirrors the Kind overlay's, so a local run is
# not starved). The full MH local-run set, required keys included, is the MH
# block in docs/DEVELOPMENT.md. MH_MAX_STREAMS is retired and no longer read.
MH_EGRESS_BUDGET_BPS=100000000
MH_EGRESS_REJECTION_RATIO_THRESHOLD=0.05
MH_MAX_REGISTERED_MEETINGS=8192
MH_MAX_EGRESS_STREAMS_PER_MEETING=512
MH_MAX_CANDIDATE_SOURCES_PER_EGRESS=16
MH_MAX_TOTAL_EGRESS_EDGES=65536
MH_POLICY_APPLY_TIMEOUT_MS=1000
MH_MAX_SOURCE_STREAMS_PER_MEETING=1024
MH_KEYFRAME_REQUEST_RETRY_MS=500
MH_KEYFRAME_REQUEST_AGGREGATION_MS=100
MH_RECOVERY_REQUESTS_PER_CONNECTION_PER_SEC=20
MH_STREAM_OPENS_PER_CONNECTION_PER_SEC=10
MH_EGRESS_STREAM_BACKLOG_BYTES=262144
MH_STREAM_MID_FRAME_STALL_MS=1000
# In-cluster this is injected by the downward API from the pod's
# resources.limits.memory (no ConfigMap key). For a local run, set it by hand.
MH_POD_MEMORY_LIMIT_BYTES=1073741824
# RETIRED — still required by the current MH image; removed with MH-A1.
MH_STREAM_COST_AUDIO_BPS=90000
MH_STREAM_COST_VIDEO_BPS=2500000
MH_MAX_MUTED_SOURCES_PER_MEETING=512

# ========================================
# Development Settings
# ========================================

# Set to "true" to enable additional development features
DEV_MODE=true
