{
  "name": "darktower",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "nx run-many -t lint && svelte-check --workspace packages/ --threshold error",
    "test:unit": "nx run-many -t test:unit",
    "test:component": "nx run-many -t test:component",
    "test:e2e": "nx run-many -t test:e2e",
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev --parallel"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.49.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "22.10.5",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "nx": "20.3.0",
    "prettier": "^3.8.4",
    "svelte-check": "^4.6.0",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.62.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6"
    }
  }
}
