{
  "name": "darktower",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "nx run-many -t lint && svelte-check --workspace packages/ --threshold error",
    "test:unit": "nx run-many -t test:unit",
    "test:component": "nx run-many -t test:component",
    "test:e2e": "nx run-many -t test:e2e",
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev --parallel"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "nx": "23.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": ">=5.0.8",
      "fast-uri": ">=3.1.4 <4",
      "postcss": ">=8.5.18"
    }
  }
}
