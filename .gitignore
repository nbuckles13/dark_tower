# Terraform
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

# NOTE: `.dockerignore` is intentionally NOT ignored — it is a committed build-context
# control file. The service image builds (cargo-chef, `COPY . .` from the repo root) and
# the devloop `git clone --local` build context both depend on it being tracked; ignoring
# it silently restored the 27 GB `target/` to every build context (disk exhaustion). See
# docs/devloop-outputs/2026-06-30-envtest-infra-reliability/main.md §0.

# OS
Thumbs.db
.env.test

# Python (used by guard scripts under scripts/guards/lib/)
__pycache__/
*.pyc
